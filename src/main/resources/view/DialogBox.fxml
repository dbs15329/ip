<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_RIGHT" spacing="10.0"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label fx:id="dialog" text="Label" wrapText="true" maxWidth="300.0" />
    <ImageView fx:id="displayPicture" fitHeight="72.0" fitWidth="72.0" preserveRatio="true" />
  </children>
  <padding>
    <Insets bottom="8.0" left="10.0" right="10.0" top="8.0" />
  </padding>
</fx:root>
