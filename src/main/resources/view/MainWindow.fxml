<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="600.0" prefWidth="460.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="nova.gui.MainWindow">
  <children>
    <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" hvalue="1.0" vvalue="1.0"
                prefHeight="545.0" prefWidth="460.0"
                AnchorPane.topAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="55.0">
      <content>
        <VBox fx:id="dialogContainer" fillWidth="true" prefWidth="445.0" />
      </content>
    </ScrollPane>
    <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="45.0"
               promptText="Type a command, e.g. todo read book"
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="85.0"
               AnchorPane.bottomAnchor="0.0" />
    <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput"
            prefHeight="45.0" prefWidth="85.0" text="Send"
            AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" />
  </children>
</AnchorPane>
